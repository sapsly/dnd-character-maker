rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // === Users (existing, unchanged) ===
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /characters/{characterId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Markers for campaigns the user has joined (listMyCampaigns lookup)
      match /joinedCampaigns/{campaignId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // === Campaigns (new) ===
    match /campaigns/{campaignId} {
      // --- Campaign doc ---
      // Members may GET the campaign doc (dmUserId, name, joinCode, members map).
      // LIST is disabled; join-code lookup is via the joinCodes collection.
      allow get: if resource.data.members[request.auth.uid] == true;
      allow list: if false;
      // Only the DM may update campaign doc fields (name, dmUserId, etc.)
      // Join flow: a new member may add ONLY themselves to the members map (no removals, no changes to existing).
      // Leave flow: a member may remove ONLY themselves from the members map (no additions, no changes to existing).
      allow update: if isDM(request.auth.uid, campaignId)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
            && (
              (request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
                && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
                && request.resource.data.members[request.auth.uid] == true)
              ||
              (request.resource.data.members.diff(resource.data.members).addedKeys().size() == 0
                && request.resource.data.members.diff(resource.data.members).removedKeys().hasOnly([request.auth.uid])
                && !(request.auth.uid in request.resource.data.members))
            ));
      // Only the DM may delete the campaign (end of life)
      allow delete: if isDM(request.auth.uid, campaignId);
      // Creation is handled client-side; authenticated users may attempt (the function
      // ensures join-code uniqueness).  The DM who creates the campaign is
      // automatically added as both dmUserId and the first member.
      allow create: if request.auth != null;
      // No direct deletion via UI; the DM function handles campaign removal.

      // --- Character copies subcollection ---
      // Document ID = the owning user's Firebase uid.
      // This guarantees exactly one copy per user per campaign and lets rules
      // authorise reads/writes purely by comparing uid against request.auth.uid.
      match /characters/{uid} {
        // Any campaign member may read all character copies (read-only roster)
        allow read: if isMember(request.auth.uid, campaignId);
        // Only the document's owning user may write their own copy (sync/overwrite)
        allow write: if request.auth.uid == uid;
        // The owning user may delete their own copy. The campaign DM may also delete
        // any copy in their campaign (used when removing a member; the DM is trusted
        // within their own campaign). Scoped by campaignId, so no cross-campaign effect.
        allow delete: if request.auth.uid == uid || isDM(request.auth.uid, campaignId);
      }
    }

    // === Join Codes (new) ===
    // joinCodes/{code} holds { campaignId, dmUserId, createdAt }
    match /joinCodes/{code} {
      allow get: if request.auth != null;
      allow create: if isDM(request.auth.uid, request.resource.data.campaignId);
      allow update: if false;
      allow delete: if request.auth.uid != null && isDM(request.auth.uid, resource.data.campaignId);
    }
  }

  // ---- Helper functions ----
  // These read the campaign doc to verify membership/DM status.
  // They are evaluated inside the rules context; the get() calls are safe because
  // the surrounding allow‑condition already guarantees the caller is authenticated
  // and (for isMember) a member of the campaign.

  function isMember(uid, campaignId) {
    let campaignDoc = get(/databases/(default)/documents/campaigns/$(campaignId));
    return campaignDoc.data.members[uid] == true;
  }

  function isDM(uid, campaignId) {
    let campaignDoc = get(/databases/(default)/documents/campaigns/$(campaignId));
    let members = campaignDoc.data.members;
    return members[uid] == true && campaignDoc.data.dmUserId == uid;
  }
}